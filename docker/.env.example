CM_PORT=3000
CM_ENV=development
CM_GIT_TOKEN=ghp_E
CM_GIT_USERNAME=

# URL of the repo to read configs from
# Owner and repo name are parsed automatically from this URL
CM_GIT_URL=https://github.com/project-lex/config-store.git
CM_GIT_BRANCH=main

# MongoDB (password is fetched from Vault, not set here)
CM_MONGODB_URI=mongodb://admin@mongodb.localhost
CM_MONGODB_DB=project-lex
CM_MONGODB_COLLECTION=configs

# HashiCorp Vault
# Token: Vault UI → Access → Auth Methods, or via CLI: vault token create
# The secret at VAULT_SECRET_PATH must have a "password" field (KV v2)
# Example: vault kv put secret/mongodb password=secret
CM_VAULT_ADDR=http://vault.localhost
CM_VAULT_TOKEN=
CM_VAULT_SECRET_PATH=database/creds/mongodb-role
CM_VAULT_NAMESPACE=
CV_PORT=3000
CV_NODE_ENV=development
CV_CONFIG_BASE_URL=https://example.com/configs/