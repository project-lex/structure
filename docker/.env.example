CM_GIT_TOKEN=ghp_E
CM_GIT_USERNAME=

# URL of the repo to read configs from
# Owner and repo name are parsed automatically from this URL
CM_GIT_URL=https://github.com/project-lex/config-store.git
CM_GIT_BRANCH=main

# MongoDB (password is fetched from Vault, not set here)
CM_MONGODB_URI=mongodb://admin@mongodb
CM_MONGODB_DB=project-lex
CM_MONGODB_COLLECTION=configs

# HashiCorp Vault (shared across services)
# Token: Vault UI → Access → Auth Methods, or via CLI: vault token create
# The secret at VAULT_SECRET_PATH must have a "password" field (KV v2)
# Example: vault kv put secret/mongodb password=secret
VAULT_ADDR=http://vault
VAULT_TOKEN=
VAULT_NAMESPACE=


CM_VAULT_SECRET_PATH=database/creds/mongodb-role
CV_PORT=3000
CV_NODE_ENV=development
CV_CONFIG_BASE_URL=https://example.com/configs/
CV_VAULT_SECRET_PATH=database/creds/mongodb-role
CV_MONGODB_URI=mongodb://mongodb
CV_MONGODB_DB=project-lex
CV_MONGODB_COLLECTION=config-deprecations
CV_MONGODB_AUTH_SOURCE=project-lex


SCHEDULER_VAULT_SECRET_PATH=database/creds/mongodb-role
SCHEDULER_MONGO_URI=mongodb://mongodb
SCHEDULER_MONGO_DATABASE=project-lex
SCHEDULER_MONGO_COLLECTION=schedules
SCHEDULER_MONGO_AUTH_SOURCE=project-lex
SCHEDULER_WEBHOOK_URL=http://example.com/webhook

QM_VAULT_SECRET_PATH=database/creds/mongodb-role
QM_FORWARD_URL=http://some-service.localhost/endpoint
# MongoDB
QM_MONGODB_URI=mongodb://mongodb
QM_MONGODB_DB=project-lex
QM_MONGODB_COLLECTION=queue
QM_MONGODB_AUTH_SOURCE=project-lex